# ==============================
# J.A.R.V.I.S. Local AI Agent
# Copy this file to .env and fill values.
# ==============================

# --- Brain (LLM) ---
# Любой мозг: lmstudio | ollama | vllm | openai | openrouter | groq | deepseek | gemini | anthropic
# Пресет задаёт base URL и модель по умолчанию; переменные ниже их переопределяют.
JARVIS_PROVIDER=lmstudio
# JARVIS_MODEL=local-model
# JARVIS_BASE_URL=http://localhost:1234/v1
# Ключ мозга. Если не задан — берётся OPENAI_API_KEY / ANTHROPIC_API_KEY / OPENROUTER_API_KEY ... по провайдеру.
# JARVIS_API_KEY=
JARVIS_LLM_TEMPERATURE=0.2
JARVIS_LLM_TIMEOUT=60
JARVIS_LLM_MAX_RETRIES=1
JARVIS_MAX_TOOL_STEPS=12
JARVIS_MAX_HISTORY=60
# Только для Claude: глубина размышлений (low | medium | high | xhigh | max). Для голоса быстрее low.
# JARVIS_EFFORT=low

# --- Voice / Audio ---
JARVIS_TTS_VOICE=ru-RU-DmitryNeural
JARVIS_STT_LANGUAGE=ru

# Голос ответа: auto — edge-tts, при сбое офлайн-голос ОС (macOS say / espeak-ng / SAPI);
# edge — только edge-tts; system — только голос ОС (без интернета).
JARVIS_TTS_ENGINE=auto
# JARVIS_SYSTEM_TTS_VOICE=Milena

# --- Voice activation («Джарвис, …») ---
# Фоновое прослушивание микрофона компьютера. Всё распознаётся локально.
JARVIS_WAKE_WORD=false
# whisper — фраза должна начинаться с «Джарвис» (любой язык);
# openwakeword — английское «Hey Jarvis», меньше нагрузка на CPU (uv sync --extra wakeword).
JARVIS_WAKE_ENGINE=whisper
JARVIS_WAKE_THRESHOLD=0.5
# Часть имени микрофона, если нужен не системный по умолчанию (например: fifine)
# JARVIS_WAKE_DEVICE=
# Отвечать голосом из динамиков компьютера (иначе — в открытом веб-интерфейсе).
JARVIS_VOICE_REPLY_LOCAL=true
# Писать в лог каждую услышанную фразу (для настройки микрофона).
JARVIS_VOICE_DEBUG=false

# --- Faster-Whisper ---
JARVIS_WHISPER_MODEL=base
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE_TYPE=int8
HF_TOKEN=

# --- Server / Security ---
# Ключ, который вводится в веб-интерфейсе. По умолчанию = JARVIS_API_KEY,
# но для облачного мозга задайте отдельный, чтобы не отдавать ключ провайдера в браузер.
JARVIS_SERVER_API_KEY=change-me

# --- Runtime paths ---
JARVIS_RULES_PATH=
JARVIS_TRIGGER_DIR=

# --- Local debugging ---
JARVIS_DEBUG_TEXT_MODE=false

# Seconds to wait for the user to approve code edits / app launches (default 120)
JARVIS_CONFIRM_TIMEOUT=120

# --- Self-improvement (RSI) ---
# Проверять правки кода в песочнице (компиляция, импорт, тесты) до показа пользователю.
JARVIS_VERIFY_CHANGES=true
JARVIS_VERIFY_TIMEOUT=180
# Таймаут run_shell_command, секунд.
JARVIS_SHELL_TIMEOUT=60
